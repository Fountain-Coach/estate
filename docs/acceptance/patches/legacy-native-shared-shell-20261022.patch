diff --git a/apps/estate-publisher/Tests/EstatePublisherCoreTests/EstatePublisherSharedShellAcceptanceTests.swift b/apps/estate-publisher/Tests/EstatePublisherCoreTests/EstatePublisherSharedShellAcceptanceTests.swift
new file mode 100644
index 00000000..b06390ce
--- /dev/null
+++ b/apps/estate-publisher/Tests/EstatePublisherCoreTests/EstatePublisherSharedShellAcceptanceTests.swift
@@ -0,0 +1,109 @@
+import Foundation
+import XCTest
+@testable import EstatePublisherCore
+
+final class EstatePublisherSharedShellAcceptanceTests: XCTestCase {
+    typealias Gate = EstatePublisherSharedShellAcceptance
+
+    private func hash(_ character: Character) -> String {
+        String(repeating: String(character), count: 64)
+    }
+
+    private func site(_ identity: String, reel: [String] = Gate.reelIDs,
+                      active: String? = nil, slots: [String] = Gate.footerSlots,
+                      legal: [String] = [Gate.statusURL],
+                      shell: String = "shell-v1",
+                      css: String? = nil, before: String? = nil,
+                      after: String? = nil) -> Gate.Site {
+        Gate.Site(identity: identity, sourceRevision: "owner-revision-1",
+                  shellVersion: shell, reelVersion: Gate.reelVersion,
+                  footerVersion: Gate.footerVersion, reelIDs: reel,
+                  activeIdentity: active ?? (identity == "status" ? nil : identity),
+                  footerSlots: slots, legalLinks: legal,
+                  cssSHA256: css ?? hash("a"), logoSHA256: hash("b"),
+                  iconSHA256: hash("c"),
+                  sourceBodySHA256Before: before ?? hash("d"),
+                  sourceBodySHA256After: after ?? hash("d"))
+    }
+
+    func testSameNineEditorialSitesAreStructurallyAdmittedWithoutPublishing() {
+        let sites = Gate.reelIDs.map { site($0) }
+        let receipt = Gate.check(sites, requiredIdentities: Gate.reelIDs)
+        XCTAssertEqual(receipt.state, "structural-accepted")
+        XCTAssertEqual(receipt.siteCount, 9)
+        XCTAssertTrue(receipt.blockers.isEmpty)
+        XCTAssertFalse(receipt.publicPublicationAuthorized)
+        XCTAssertEqual(Gate.primaryEntrances, ["estate", "solstice", "teatro"])
+    }
+
+    func testSubsetLocalProofNeverClaimsPublicPublication() {
+        let sample = ["estate", "solstice"].map { site($0) }
+        let receipt = Gate.check(sample, requiredIdentities: ["estate", "solstice"])
+        XCTAssertTrue(receipt.accepted)
+        XCTAssertFalse(receipt.publicPublicationAuthorized)
+        XCTAssertFalse(Gate.reelIDs.contains("status"))
+    }
+
+    func testWrongLinkOrderFailsClosed() {
+        var ids = Gate.reelIDs
+        ids.swapAt(0, 1)
+        let receipt = Gate.check([site("estate", reel: ids)], requiredIdentities: ["estate"])
+        XCTAssertTrue(receipt.blockers.contains("reel-membership-order-drift"))
+    }
+
+    func testMissingStatusInLegalFooterFailsClosed() {
+        let receipt = Gate.check([site("estate", legal: [])], requiredIdentities: ["estate"])
+        XCTAssertTrue(receipt.blockers.contains("footer-legal-drift"))
+    }
+
+    func testFooterRoleMutationFailsClosed() {
+        let receipt = Gate.check([site("estate", slots: ["imprint", "rights"])],
+                                 requiredIdentities: ["estate"])
+        XCTAssertTrue(receipt.blockers.contains("footer-legal-drift"))
+    }
+
+    func testSourceChangeAndVisualStylesAreIndependentFailures() {
+        let items = [site("estate"), site("teatro", css: hash("e"), after: hash("f"))]
+        let receipt = Gate.check(items, requiredIdentities: ["estate", "teatro"])
+        XCTAssertTrue(receipt.blockers.contains("shared-chrome-digest-drift"))
+        XCTAssertTrue(receipt.blockers.contains("source-content-mutation"))
+    }
+
+    func testAdditionalStatusTopReelFailsClosed() {
+        let items = [site("estate", reel: Gate.reelIDs + ["status"])]
+        let receipt = Gate.check(items, requiredIdentities: ["estate"])
+        XCTAssertTrue(receipt.blockers.contains("reel-membership-order-drift"))
+    }
+
+    func testWrongActiveDomainFailsClosed() {
+        let bad = Gate.Site(identity: "solstice", sourceRevision: "source",
+            shellVersion: "shell-v1", reelVersion: Gate.reelVersion,
+            footerVersion: Gate.footerVersion, reelIDs: Gate.reelIDs,
+            activeIdentity: "teatro", footerSlots: Gate.footerSlots,
+            legalLinks: [Gate.statusURL], cssSHA256: hash("a"),
+            logoSHA256: hash("b"), iconSHA256: hash("c"),
+            sourceBodySHA256Before: hash("d"), sourceBodySHA256After: hash("d"))
+        XCTAssertTrue(Gate.check([bad], requiredIdentities: ["solstice"])
+                        .blockers.contains("active-identity-drift"))
+    }
+
+    func testAbsentHostRefusesFullEstateClaim() {
+        let sites = Gate.reelIDs.filter { $0 != "teatro" }.map { site($0) }
+        let receipt = Gate.check(sites, requiredIdentities: Gate.reelIDs)
+        XCTAssertTrue(receipt.blockers.contains("site-coverage-drift"))
+    }
+
+    func testStaleOrForgedDigestRefused() {
+        let receipt = Gate.check([site("estate", css: "not-a-hash")],
+                                 requiredIdentities: ["estate"])
+        XCTAssertTrue(receipt.blockers.contains("unverified-asset-digest"))
+    }
+
+    func testNoIndependentReframeBookshelfPublicationConflation() {
+        // The three editorial entrances and nine public reel destinations are
+        // separate from any number of privately admitted Reframe manuscripts.
+        XCTAssertEqual(Gate.primaryEntrances.count, 3)
+        XCTAssertEqual(Gate.reelIDs.count, 9)
+        XCTAssertFalse(Gate.reelIDs.contains("reframe-bookshelf-work"))
+    }
+}
