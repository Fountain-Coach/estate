+++ b/apps/estate-publisher/Sources/EstatePublisherCore/EstatePublisherSharedShellAcceptance.swift
@@ -0,0 +1,109 @@
+import Foundation
+
+/// Structural gate owned by EstatePublisher, distinct from Fountain Press composition
+/// and Reframe's private Bookshelf admission. Preview evaluation NEVER authorizes release.
+public enum EstatePublisherSharedShellAcceptance {
+    public static let reelIDs = [
+        "estate", "book", "governance", "midi2", "instruments",
+        "teatro", "satzfunk", "pointer", "solstice"
+    ]
+    public static let primaryEntrances = ["estate", "solstice", "teatro"]
+    public static let footerSlots = ["imprint", "provenance", "legal", "release-state"]
+    public static let statusURL = "https://status.fountain.coach/"
+    public static let reelVersion = "fountain.estate.canonical-reel.v1"
+    public static let footerVersion = "fountain.estate.canonical-footer.v1"
+
+    public struct Site: Codable, Equatable, Sendable {
+        public let identity: String
+        public let sourceRevision: String
+        public let shellVersion: String
+        public let reelVersion: String
+        public let footerVersion: String
+        public let reelIDs: [String]
+        public let activeIdentity: String?
+        public let footerSlots: [String]
+        public let legalLinks: [String]
+        public let cssSHA256: String
+        public let logoSHA256: String
+        public let iconSHA256: String
+        public let sourceBodySHA256Before: String
+        public let sourceBodySHA256After: String
+
+        public init(identity: String, sourceRevision: String, shellVersion: String,
+                    reelVersion: String, footerVersion: String, reelIDs: [String],
+                    activeIdentity: String?, footerSlots: [String], legalLinks: [String],
+                    cssSHA256: String, logoSHA256: String, iconSHA256: String,
+                    sourceBodySHA256Before: String, sourceBodySHA256After: String) {
+            self.identity = identity
+            self.sourceRevision = sourceRevision
+            self.shellVersion = shellVersion
+            self.reelVersion = reelVersion
+            self.footerVersion = footerVersion
+            self.reelIDs = reelIDs
+            self.activeIdentity = activeIdentity
+            self.footerSlots = footerSlots
+            self.legalLinks = legalLinks
+            self.cssSHA256 = cssSHA256
+            self.logoSHA256 = logoSHA256
+            self.iconSHA256 = iconSHA256
+            self.sourceBodySHA256Before = sourceBodySHA256Before
+            self.sourceBodySHA256After = sourceBodySHA256After
+        }
+    }
+
+    public struct Receipt: Codable, Equatable, Sendable {
+        public let state: String
+        public let siteCount: Int
+        public let shellVersion: String?
+        public let blockers: [String]
+        /// Must stay false. Only the typed EstatePublisher release executor can publish.
+        public let publicPublicationAuthorized: Bool
+        public var accepted: Bool { state == "structural-accepted" }
+    }
+
+    /// Pure gate over *independently measured* page observations. Browser/WebKit
+    /// geometry and actual public release remain separate mandatory evidence.
+    public static func check(_ sites: [Site], requiredIdentities: [String]) -> Receipt {
+        var errors: [String] = []
+        func fail(_ code: String) { if !errors.contains(code) { errors.append(code) } }
+        let expected = Set(requiredIdentities)
+        let observed = sites.map(\.identity)
+        if sites.isEmpty || expected.isEmpty || Set(observed) != expected ||
+           observed.count != Set(observed).count { fail("site-coverage-drift") }
+        if requiredIdentities.contains("status") && expected.count == reelIDs.count {
+            fail("status-is-footer-only")
+        }
+        for site in sites {
+            if site.sourceRevision.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+                fail("unpinned-source")
+            }
+            if site.shellVersion.isEmpty || site.reelVersion != reelVersion ||
+                site.footerVersion != footerVersion { fail("shell-version-drift") }
+            if site.reelIDs != reelIDs { fail("reel-membership-order-drift") }
+            if site.activeIdentity != (site.identity == "status" ? nil : site.identity) {
+                fail("active-identity-drift")
+            }
+            if site.footerSlots != footerSlots || !site.legalLinks.contains(statusURL) {
+                fail("footer-legal-drift")
+            }
+            for hash in [site.cssSHA256, site.logoSHA256, site.iconSHA256,
+                         site.sourceBodySHA256Before, site.sourceBodySHA256After] {
+                if hash.count != 64 || !hash.utf8.allSatisfy({ ($0 >= 48 && $0 <= 57) ||
+                                                            ($0 >= 97 && $0 <= 102) }) {
+                    fail("unverified-asset-digest")
+                }
+            }
+            if site.sourceBodySHA256Before != site.sourceBodySHA256After {
+                fail("source-content-mutation")
+            }
+        }
+        for keyPath in [\Site.shellVersion, \Site.cssSHA256, \Site.logoSHA256, \Site.iconSHA256] {
+            if Set(sites.map { $0[keyPath: keyPath] }).count > 1 {
+                fail("shared-chrome-digest-drift")
+            }
+        }
+        return Receipt(state: errors.isEmpty ? "structural-accepted" : "blocked",
+                       siteCount: sites.count, shellVersion: sites.first?.shellVersion,
+                       blockers: errors.sorted(), publicPublicationAuthorized: false)
+    }
+}
